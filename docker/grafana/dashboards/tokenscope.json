{
  "uid": "tokenscope",
  "title": "tokenscope \u2014 Claude Code usage",
  "tags": [
    "tokenscope"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "time_options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(tokenscope_requests_total, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Model"
      },
      {
        "name": "project_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(tokenscope_requests_total, project_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Project"
      },
      {
        "name": "subscription_mode",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(tokenscope_requests_total, tokenscope_subscription_mode)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "enterprise",
          "value": "enterprise"
        },
        "label": "Mode",
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Mode",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Subscription mode",
      "description": "Driven by the tokenscope.subscription_mode OTEL resource attribute. 'unknown' indicates the attribute is missing from current data \u2014 usually because the stack started before Phase 5+ wiring.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (tokenscope_subscription_mode) (tokenscope_requests_total))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "#4E92E0"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "name",
        "text": {
          "titleSize": 14,
          "valueSize": 22
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regexp": ".*",
            "renamePattern": "Mode: $subscription_mode  \u2022  Claude Code sessions only \u2014 claude.ai web/desktop not tracked"
          }
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Cost \u2014 last 24h",
      "description": "24-hour cost (rolling window). PromQL: sum(increase(tokenscope_cost_usd_total[24h])). Independent of the dashboard time picker.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[24h]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E8E93"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Cost \u2014 last 7d",
      "description": "7-day cost (rolling window). PromQL: sum(increase(tokenscope_cost_usd_total[7d])). Independent of the dashboard time picker.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[7d]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E8E93"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Cost \u2014 last 30d",
      "description": "30-day cost (rolling window). PromQL: sum(increase(tokenscope_cost_usd_total[30d])). Independent of the dashboard time picker.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[30d]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E8E93"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Saved by caching",
      "description": "Estimated savings from prompt caching over the dashboard time range.\n\nMath: 9 \u00d7 cache_read_cost. Cache reads cost 0.1\u00d7 the model's base input rate, so each cached token saved 0.9\u00d7 input rate \u2014 i.e. 9\u00d7 the cache_read cost in absolute terms.\n\nRead as: 'what you would have paid if cache hits had been billed at full input rate, minus what you actually paid.' For heavily-cached workflows this number routinely dwarfs total cost, because total cost is itself reduced by the same caching.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(tokenscope_cost_usd_total{component=\"cache_read\", model=~\"$model\", project_name=~\"$project_name\"}[$__range])) * 9",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#39A974"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Active sessions",
      "description": "Sessions with activity in the last 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tokenscope_sessions_active",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4E92E0"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 106,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Average cumulative cache_read / (cache_read + input) across reporting sessions. 4 decimals because long heavily-cached sessions naturally approach 1.0; the precision matters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 5,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(tokenscope_cache_hit_ratio{project_name=~\"$project_name\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8E8E93"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Cost trends",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "Cumulative cost by model (since process start)",
      "description": "Raw counter value over time, per model. Monotonically non-decreasing during steady state. The line drops to current process cumulative on container restart (OTEL Collector counter reset); this is a known Prometheus counter behaviour \u2014 see docs/metric-reference.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"})",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        }
      }
    },
    {
      "id": 202,
      "type": "piechart",
      "title": "Cost share by component",
      "description": "Where the money goes: input / output / cache_read / cache_write_5m / cache_write_1h. Cache-read share is the headline 'caching is working' signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (component) (increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[$__range]))",
          "legendFormat": "{{component}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ],
          "showLegend": true
        },
        "displayLabels": []
      },
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Value",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ],
            "type": "include",
            "match": "all"
          }
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Sessions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 301,
      "type": "table",
      "title": "Recently active sessions",
      "description": "Sessions with new requests in the last 15 minutes. Aggregated by session_id (one row per session).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(  (sum by (session_id, model) (tokenscope_requests_total{model=~\"$model\", project_name=~\"$project_name\"})) and (sum by (session_id) (increase(tokenscope_requests_total[15m])) > 0),  \"session_short\", \"$1\", \"session_id\", \"^(.{8}).*$\")",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "requests"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (session_id) (tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"})",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "cost"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "tokenscope_subscription_mode": true,
              "service_name": true,
              "tokenscope_pipeline": true,
              "exported_job": true,
              "source": true,
              "otel_scope_name": true,
              "otel_scope_version": true,
              "telemetry_sdk_language": true,
              "telemetry_sdk_name": true,
              "telemetry_sdk_version": true
            },
            "renameByName": {
              "session_short": "Session",
              "session_id": "Full UUID",
              "model": "Model",
              "Value #A": "Requests",
              "Value #B": "Cost (USD)"
            },
            "indexByName": {
              "session_short": 0,
              "session_id": 1,
              "model": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Cost (USD)",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Full UUID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 302,
      "type": "table",
      "title": "Top sessions by cost",
      "description": "One row per session_id, summed across any projects the session touched. Session short shows first 8 chars; full UUID on hover.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(  topk(20, sum by (session_id) (tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"})),  \"session_short\", \"$1\", \"session_id\", \"^(.{8}).*$\")",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "tokenscope_subscription_mode": true,
              "service_name": true,
              "tokenscope_pipeline": true,
              "exported_job": true,
              "source": true,
              "otel_scope_name": true,
              "otel_scope_version": true,
              "telemetry_sdk_language": true,
              "telemetry_sdk_name": true,
              "telemetry_sdk_version": true
            },
            "renameByName": {
              "session_short": "Session",
              "session_id": "Full UUID",
              "Value": "Cost (USD)"
            },
            "indexByName": {
              "session_short": 0,
              "session_id": 1,
              "Value": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Cost (USD)",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Full UUID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Cache efficiency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 401,
      "type": "table",
      "title": "Cache hit ratio per session",
      "description": "Hit ratio per session_id (aggregated). No threshold coloring \u2014 100% is not universally 'good'; depends entirely on session shape.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(  topk(20, avg by (session_id) (tokenscope_cache_hit_ratio{project_name=~\"$project_name\"})),  \"session_short\", \"$1\", \"session_id\", \"^(.{8}).*$\")",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "tokenscope_subscription_mode": true,
              "service_name": true,
