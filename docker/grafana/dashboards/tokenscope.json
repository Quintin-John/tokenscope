{
  "uid": "tokenscope",
  "title": "tokenscope",
  "tags": ["tokenscope"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["15s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(tokenscope_requests_total, model)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "label": "Model"
      },
      {
        "name": "project_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(tokenscope_requests_total, project_name)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "label": "Project"
      },
      {
        "name": "subscription_mode",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(tokenscope_requests_total, tokenscope_subscription_mode)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "multi": false,
        "includeAll": false,
        "current": { "text": "enterprise", "value": "enterprise" },
        "label": "Mode",
        "hide": 2
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Mode",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Subscription mode",
      "description": "Driven by the tokenscope.subscription_mode OTEL resource attribute. 'unknown' indicates the attribute is missing from current data — usually because the stack started before Phase 5+ wiring.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 3 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (tokenscope_subscription_mode) (tokenscope_requests_total))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "color": { "mode": "fixed", "fixedColor": "#4E92E0" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "name",
        "text": { "titleSize": 14, "valueSize": 22 }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regexp": ".*", "renamePattern": "Mode: $subscription_mode  •  costs in USD" }
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Cost — last 24h",
      "description": "Sum of all USD cost components for the dashboard's time range. Window adapts to the time picker.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": { "mode": "fixed", "fixedColor": "#8E8E93" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Cost — 7 days",
      "description": "Last 7 days. Independent of the dashboard time picker so the headline numbers stay anchored to standard windows.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 5, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[7d]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "#8E8E93" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Cost — 30 days",
      "description": "Last 30 days. Independent of the dashboard time picker.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 5, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[30d]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "#8E8E93" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Saved by caching",
      "description": "Estimated savings from prompt caching over the dashboard time range. Math: 9 × cache_read_cost (cache reads cost 0.1× base input rate, so each cached token saved 0.9× base input rate — 9× the cache-read cost in absolute terms).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 5, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(tokenscope_cost_usd_total{component=\"cache_read\", model=~\"$model\", project_name=~\"$project_name\"}[$__range])) * 9",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "#39A974" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "textMode": "value" }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Active sessions",
      "description": "Sessions with activity in the last 10 minutes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 5, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tokenscope_sessions_active",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#4E92E0" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value" }
    },
    {
      "id": 106,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Average across all reporting sessions. Range 0.0–1.0. No threshold coloring — there is no universal 'good' ratio; depends entirely on session shape.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 20, "y": 5, "w": 4, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(tokenscope_cache_hit_ratio{project_name=~\"$project_name\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "fixed", "fixedColor": "#8E8E93" }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "textMode": "value" }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Cost trends",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 1 }
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "Cumulative cost by model",
      "description": "Running total USD per model. PromQL uses increase() inside the window (reset-aware) and Grafana's Cumulative Sum transformation produces the monotonic line. Counter resets at container restart no longer cause sawtooth drops.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 11, "w": 16, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (model) (increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[$__interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "alias": "",
            "binary": {},
            "reduce": {},
            "cumulative": { "reducer": "sum" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"], "showLegend": true }
      }
    },
    {
      "id": 202,
      "type": "piechart",
      "title": "Cost share by component",
      "description": "Where the money goes: input / output / cache_read / cache_write_5m / cache_write_1h. Cache-read share is the headline 'caching is working' signal.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 11, "w": 8, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (component) (increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[$__range]))",
          "legendFormat": "{{component}}",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "options": {
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"], "showLegend": true },
        "displayLabels": []
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Sessions",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 }
    },
    {
      "id": 301,
      "type": "table",
      "title": "Recently active sessions",
      "description": "Sessions with new requests in the last 15 minutes. Sorted by cost desc.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum by (session_id, project_name, model) (tokenscope_requests_total{model=~\"$model\", project_name=~\"$project_name\"})) and (sum by (session_id) (increase(tokenscope_requests_total[15m])) > 0)",
          "instant": true,
          "format": "table",
          "legendFormat": "requests"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (session_id) (tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"})",
          "instant": true,
          "format": "table",
          "legendFormat": "cost"
        }
      ],
      "transformations": [
        { "id": "merge" },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "__name__": true, "job": true, "instance": true, "tokenscope_subscription_mode": true, "service_name": true, "tokenscope_pipeline": true, "exported_job": true, "source": true, "otel_scope_name": true, "otel_scope_version": true, "telemetry_sdk_language": true, "telemetry_sdk_name": true, "telemetry_sdk_version": true, "project": true },
            "renameByName": {
              "session_id": "Session",
              "project_name": "Project",
              "model": "Model",
              "Value #A": "Requests",
              "Value #B": "Cost (USD)"
            },
            "indexByName": { "session_id": 0, "project_name": 1, "model": 2, "Value #A": 3, "Value #B": 4 }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Cost (USD)", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Cost (USD)" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }] },
          { "matcher": { "id": "byName", "options": "Requests" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } }
    },
    {
      "id": 302,
      "type": "table",
      "title": "Top sessions by cost (history)",
      "description": "Every session ever observed, ranked by total cost. Hover Session for full UUID.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(20, sum by (session_id, project_name) (tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "tokenscope_subscription_mode": true, "service_name": true, "tokenscope_pipeline": true, "exported_job": true, "source": true, "otel_scope_name": true, "otel_scope_version": true, "telemetry_sdk_language": true, "telemetry_sdk_name": true, "telemetry_sdk_version": true, "project": true },
            "renameByName": { "session_id": "Session", "project_name": "Project", "Value": "Cost (USD)" },
            "indexByName": { "session_id": 0, "project_name": 1, "Value": 2 }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Cost (USD)", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Cost (USD)" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 4 }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } }] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Cache efficiency",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 }
    },
    {
      "id": 401,
      "type": "table",
      "title": "Cache hit ratio per session",
      "description": "Top 20 sessions by cache_read + input volume, showing their hit ratio. Sortable by any column.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(20, tokenscope_cache_hit_ratio{project_name=~\"$project_name\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "tokenscope_subscription_mode": true, "service_name": true, "tokenscope_pipeline": true, "exported_job": true, "source": true, "otel_scope_name": true, "otel_scope_version": true, "telemetry_sdk_language": true, "telemetry_sdk_name": true, "telemetry_sdk_version": true, "project": true },
            "renameByName": { "session_id": "Session", "project_name": "Project", "Value": "Hit ratio" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Hit ratio" }, "properties": [{ "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 1 }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }, { "id": "min", "value": 0 }, { "id": "max", "value": 1 }] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } }
    },
    {
      "id": 402,
      "type": "timeseries",
      "title": "Cache read vs cache write tokens",
      "description": "Token throughput by cache operation. Read = served from cache (cheap). Write = first time tokens are stored (1.25× or 2× input rate).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(tokenscope_tokens_cache_read_total{model=~\"$model\", project_name=~\"$project_name\"}[5m]))",
          "legendFormat": "cache_read"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (ttl) (rate(tokenscope_tokens_cache_write_total{model=~\"$model\", project_name=~\"$project_name\"}[5m]))",
          "legendFormat": "cache_write_{{ttl}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "showLegend": true }
      }
    },
    {
      "id": 500,
      "type": "row",
      "title": "Cost breakdown detail",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 501,
          "type": "piechart",
          "title": "Cost by model",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "x": 0, "y": 41, "w": 8, "h": 9 },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "sum by (model) (increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[$__range]))",
              "legendFormat": "{{model}}",
              "instant": true
            }
          ],
          "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
          "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"], "showLegend": true } }
        },
        {
          "id": 502,
          "type": "timeseries",
          "title": "Daily cost trend (with 7-day moving avg)",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "x": 8, "y": 41, "w": 10, "h": 9 },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[1d]))",
              "legendFormat": "daily"
            },
            {
              "refId": "B",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
              "expr": "avg_over_time(sum(increase(tokenscope_cost_usd_total{model=~\"$model\", project_name=~\"$project_name\"}[1d]))[7d:1d])",
              "legendFormat": "7-day avg"
            }
          ],
          "fieldConfig": {
            "defaults": { "unit": "currencyUSD", "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto" } },
            "overrides": [
              { "matcher": { "id": "byName", "options": "7-day avg" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 5] } }] }
            ]
          },
          "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
        },
        {
          "id": 503,
          "type": "barchart",
          "title": "Token volume by model",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "x": 18, "y": 41, "w": 6, "h": 9 },
          "targets": [
            {
              "refId": "A",
              "datasource": { "type": "prometheus", "uid": "prometheus" },
