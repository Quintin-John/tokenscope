<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!--
      Suppress NuGet warnings that fire incorrectly under Central Package
      Management:
        NU1604 — "PackageReference lacks lower bound" (CPM puts the version
                 in Directory.Packages.props, which is the whole point).
        NU1602 — Companion to NU1604, fires on approximate-match resolution.
        NU1701 — YamlDotNet (transitive of NetEscapades.Configuration.Yaml)
                 advertises a .NETFramework TFM as its primary; it's
                 functionally compatible with net8.0 via netstandard2.0.
                 Confirmed working at runtime; suppressing the warning.
    -->
    <NoWarn>$(NoWarn);NU1604;NU1602;NU1701</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Company>tokenscope contributors</Company>
    <Authors>Quintin John</Authors>
    <Copyright>Copyright (c) 2026 Quintin John</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Quintin-John/tokenscope.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
