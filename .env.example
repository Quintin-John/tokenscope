# tokenscope docker-compose environment variables
#
# Copy to `.env` (gitignored automatically — .env is not tracked) and
# customise as needed. All variables have sensible defaults in
# docker-compose.yml; this file documents what's available.

# ---------- Grafana admin credentials ----------
# Default: admin / tokenscope. Grafana prompts for a password change on
# first login. Override here for non-default initial credentials.
TOKENSCOPE_GRAFANA_USER=admin
TOKENSCOPE_GRAFANA_PASSWORD=tokenscope

# ---------- Host path resolution ----------
# `${HOME}/.claude/projects` is bind-mounted into the collector
# container as the session-log source. The container reads it read-only.
#
# macOS / Linux: ${HOME} resolves automatically. No action needed.
#
# Windows Docker Desktop with WSL2: run `docker compose` from a WSL2
# shell. ${HOME} must resolve to your WSL2 home (e.g. /home/quintin),
# NOT your Windows profile (C:\Users\quintin). If you must run compose
# from PowerShell, set HOME explicitly to the WSL path:
#   $env:HOME = "/home/quintin"
# before invoking docker compose.

# ---------- Optional: tokenscope collector overrides ----------
# The four TOKENSCOPE_* env vars below are already wired in
# docker-compose.yml. Override here only if you've customised the
# in-container paths (rare).
#
# TOKENSCOPE_SESSION_LOGS__PATH=/data/claude-logs
# TOKENSCOPE_STATE__PATH=/data/state
# TOKENSCOPE_PRICING__CONFIG_PATH=/data/config/pricing.json
# TOKENSCOPE_OTLP__ENDPOINT=http://otel-collector:4317

# ---------- Polling for FileSystemWatcher fallback ----------
# Defaults to TRUE in docker-compose.yml. On Docker Desktop for macOS,
# the host's gRPC FUSE bind-mount doesn't reliably propagate inotify
# events to the Linux container, so polling is the only way live
# session updates get picked up. Verified during Phase 6 smoke testing.
#
# Linux native users (no FUSE in the way): inotify works directly.
# Override to "false" for slightly better latency.
# TOKENSCOPE_SESSION_LOGS__USE_POLLING=false
#
# Polling interval — how often the collector re-scans the session-log
# tree when polling is enabled. Defaults to 5s; lower = faster
# pickup, higher CPU.
# TOKENSCOPE_SESSION_LOGS__POLLING_INTERVAL_SECONDS=5
